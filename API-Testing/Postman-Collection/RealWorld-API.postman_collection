              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response contains article\", function () {\r",
                  "    pm.expect(jsonData.article).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Article contains slug\", function () {\r",
                  "    pm.expect(jsonData.article.slug).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Article title is not empty\", function () {\r",
                  "    pm.expect(jsonData.article.title).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "// Сохраняем slug созданной статьи\r",
                  "if (jsonData.article && jsonData.article.slug) {\r",
                  "    pm.environment.set(\"slug\", jsonData.article.slug);\r",
